# Copy this file to .env and fill in your key
# Get a free key (no credit card) at https://console.groq.com
GROQ_API_KEY=gsk_your-key-here

# Model to use for answers (free tier, open-source, hosted on Groq's LPUs)
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally via sentence-transformers, always free)
EMBEDDING_MODEL=all-MiniLM-L6-v2
